"use client";

import { useEffect, useState, useRef } from "react";
import Link from "next/link";
import Image from "next/image";
import { usePathname } from "next/navigation";
import { Menu, X, Phone, ChevronDown, MapPin, Search } from "lucide-react";
import { Container } from "@/components/ui";
import type { SiteHeaderData } from "@/types/cms";

// ── Fallback constants ─────────────────────────────────────────
const DEFAULT_NAV = [
  { label: "Cabs",   href: "/cabs" },
  { label: "Hotels", href: "/hotels" },
  { label: "Tours",  href: "/tours" },
  { label: "Track",  href: "/track" },
];

const SECONDARY = [
  { label: "About",            href: "/about" },
  { label: "Become a Partner", href: "/partner" },
  { label: "Contact",          href: "/contact" },
];

const DEFAULT_SUPPORT_PHONE = "1800-WAYTERO";
const DEFAULT_TAGLINE       = "India's Travel OS";
const DEFAULT_CTA_TEXT      = "Book a Cab";
const DEFAULT_CTA_LINK      = "/cabs";

interface Props {
  cmsData?: SiteHeaderData | null;
}

export default function Header({ cmsData }: Props) {
  const pathname             = usePathname() ?? "";
  const [open, setOpen]      = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [scrollY, setScrollY]   = useState(0);
  const [moreOpen, setMoreOpen] = useState(false);
  const moreRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const onScroll = () => {
      setScrollY(window.scrollY);
      setScrolled(window.scrollY > 12);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  useEffect(() => { setOpen(false); setMoreOpen(false); }, [pathname]);

  // Close "More" dropdown on outside click
  useEffect(() => {
    const handler = (e: MouseEvent) => {
      if (moreRef.current && !moreRef.current.contains(e.target as Node)) {
        setMoreOpen(false);
      }
    };
    document.addEventListener("mousedown", handler);
    return () => document.removeEventListener("mousedown", handler);
  }, []);

  const isActive = (href: string) =>
    pathname === href || pathname.startsWith(href + "/");

  const rawCmsNav = (cmsData?.nav_links ?? []).filter((n) => n?.href && n?.label);
  const navLinks  = rawCmsNav.length > 0 ? rawCmsNav : DEFAULT_NAV;

  const mobileLinks = [
    ...navLinks,
    ...SECONDARY.filter((s) => !navLinks.some((n) => n.href === s.href)),
  ];

  const logoUrl      = cmsData?.logo_url      ?? null;
  const logoAlt      = cmsData?.logo_alt_text ?? "WayTero";
  const tagline      = cmsData?.tagline       ?? DEFAULT_TAGLINE;
  const supportPhone = cmsData?.support_phone ?? DEFAULT_SUPPORT_PHONE;
  const ctaText      = cmsData?.cta_text      ?? DEFAULT_CTA_TEXT;
  const ctaLink      = cmsData?.cta_link      ?? DEFAULT_CTA_LINK;
  const showLogin    = cmsData?.show_login_button ?? true;

  // Header background transitions from transparent → glass → solid as you scroll
  const headerBg = scrolled
    ? "bg-white/95 backdrop-blur-xl shadow-[0_1px_0_0_rgba(229,231,235,0.8),0_8px_32px_rgba(11,27,59,0.08)]"
    : "bg-white/60 backdrop-blur-md";

  return (
    <>
      {/* ── Announcement strip ───────────────────────────────── */}
      <div
        className="relative overflow-hidden"
        style={{
          background: "linear-gradient(90deg, #0B1B3B 0%, #1A56DB 50%, #0B1B3B 100%)",
          transform: `translateY(${Math.min(scrollY * 0.4, 36)}px)`,
          opacity: Math.max(0, 1 - scrollY / 60),
          transition: "opacity 120ms ease",
        }}
      >
        {/* Subtle shimmer */}
        <div
          className="absolute inset-0 pointer-events-none"
          style={{
            background:
              "linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.06) 50%, transparent 60%)",
            animation: "shimmer 4s linear infinite",
          }}
        />
        <Container size="xl" className="relative flex items-center justify-between h-9">
          <div className="flex items-center gap-5 text-white/80 text-xs font-medium">
            <span className="inline-flex items-center gap-1.5">
              <Phone className="h-3 w-3 text-amber-400" aria-hidden />
              <span className="text-white/60">24/7 support</span>
              <span className="text-amber-400 font-semibold">{supportPhone}</span>
            </span>
            <span className="hidden sm:block text-white/30">·</span>
            <span className="hidden sm:block text-white/70">{tagline}</span>
          </div>
          <div className="flex items-center gap-4 text-xs text-white/60">
            <Link href="/track" className="hidden md:inline-flex items-center gap-1 hover:text-white transition-colors duration-200">
              <MapPin className="h-3 w-3" /> Track Booking
            </Link>
            <span className="hidden md:block text-white/20">·</span>
            <Link href="/partner" className="hidden md:inline-flex hover:text-white transition-colors duration-200">
              List Your Business
            </Link>
          </div>
        </Container>
      </div>

      {/* ── Main header ──────────────────────────────────────── */}
      <header
        className={`sticky top-0 z-40 transition-all duration-300 ease-out ${headerBg}`}
      >
        {/* Active page indicator line */}
        <div
          className="absolute bottom-0 left-0 h-[2px] bg-gradient-to-r from-primary-600 via-accent-500 to-primary-600 transition-all duration-700"
          style={{ width: scrolled ? "100%" : "0%", opacity: scrolled ? 1 : 0 }}
        />

        <Container size="xl" className="flex items-center justify-between h-16 lg:h-[68px]">

          {/* ── Logo ── */}
          <Link href="/" className="flex items-center gap-2.5 group flex-shrink-0">
            {logoUrl ? (
              <div className="relative">
                <Image
                  src={logoUrl}
                  alt={logoAlt}
                  width={140}
                  height={40}
                  className="h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.03]"
                  priority
                />
              </div>
            ) : (
              <div className="flex items-center gap-2.5">
                <div className="relative h-9 w-9 flex-shrink-0">
                  <div className="absolute inset-0 rounded-xl bg-gradient-to-br from-primary-500 to-primary-800 shadow-[0_4px_12px_rgba(26,86,219,0.4)] group-hover:shadow-[0_6px_20px_rgba(26,86,219,0.55)] transition-all duration-300 group-hover:scale-110" />
                  <span className="absolute inset-0 flex items-center justify-center text-white font-black text-sm">W</span>
                </div>
                <div className="leading-none">
                  <div className="text-[22px] font-black tracking-[-0.03em] text-ink">
                    Way<span className="text-primary-600">Tero</span>
                  </div>
                  <div className="text-[9px] font-bold uppercase tracking-[0.22em] text-ink-4 mt-px">
                    Travel OS
                  </div>
                </div>
              </div>
            )}
          </Link>

          {/* ── Desktop nav ── */}
          <nav className="hidden lg:flex items-center gap-0.5 mx-6 flex-1 justify-center max-w-md">
            {navLinks.map((n, i) => (
              <Link
                key={`nav-${i}-${n.href}`}
                href={n.href}
                className={`relative px-3.5 py-2 rounded-lg text-[13.5px] font-semibold transition-all duration-200 ${
                  isActive(n.href)
                    ? "text-primary-600"
                    : "text-ink-3 hover:text-ink"
                }`}
              >
                {isActive(n.href) && (
                  <span className="absolute inset-0 rounded-lg bg-primary-50 border border-primary-100" />
                )}
                <span className="relative">{n.label}</span>
              </Link>
            ))}

            {/* More dropdown */}
            <div ref={moreRef} className="relative">
              <button
                onClick={() => setMoreOpen((v) => !v)}
                className="flex items-center gap-1 px-3.5 py-2 rounded-lg text-[13.5px] font-semibold text-ink-3 hover:text-ink transition-colors duration-200"
              >
                More
                <ChevronDown
                  className={`h-3.5 w-3.5 transition-transform duration-200 ${moreOpen ? "rotate-180" : ""}`}
                />
              </button>
              {moreOpen && (
                <div className="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 rounded-xl bg-white border border-ink-7 shadow-wt-lg overflow-hidden animate-in fade-in slide-in-from-top-2 duration-200">
                  {SECONDARY.map((s) => (
                    <Link
                      key={s.href}
                      href={s.href}
                      className="block px-4 py-2.5 text-sm text-ink-2 hover:bg-ink-9 hover:text-primary-600 transition-colors"
                    >
                      {s.label}
                    </Link>
                  ))}
                </div>
              )}
            </div>
          </nav>

          {/* ── Right side actions ── */}
          <div className="hidden md:flex items-center gap-2 flex-shrink-0">
            {showLogin && (
              <Link
                href="/login"
                className="px-4 h-9 inline-flex items-center text-[13.5px] font-semibold text-ink-3 hover:text-primary-600 rounded-lg transition-colors duration-200"
              >
                Log in
              </Link>
            )}
            <Link
              href={ctaLink}
              className="group relative overflow-hidden px-5 h-9 inline-flex items-center text-[13.5px] font-bold text-white rounded-lg transition-all duration-300"
              style={{
                background: "linear-gradient(135deg, #1A56DB 0%, #1140A3 100%)",
                boxShadow: "0 4px 14px rgba(26,86,219,0.35)",
              }}
            >
              {/* Shine sweep on hover */}
              <span className="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-500 bg-gradient-to-r from-transparent via-white/20 to-transparent" />
              <span className="relative">{ctaText}</span>
            </Link>
          </div>

          {/* ── Mobile toggle ── */}
          <button
            className="lg:hidden inline-flex h-9 w-9 items-center justify-center rounded-lg text-ink-2 hover:bg-ink-8 transition-colors"
            aria-label="Toggle menu"
            onClick={() => setOpen((v) => !v)}
          >
            <span className={`absolute transition-all duration-200 ${open ? "opacity-100 rotate-0" : "opacity-0 rotate-90"}`}>
              <X className="h-5 w-5" />
            </span>
            <span className={`absolute transition-all duration-200 ${open ? "opacity-0 -rotate-90" : "opacity-100 rotate-0"}`}>
              <Menu className="h-5 w-5" />
            </span>
          </button>
        </Container>

        {/* ── Mobile drawer ── */}
        <div
          className={`lg:hidden border-t border-ink-7/60 bg-white/98 backdrop-blur-xl overflow-hidden transition-all duration-300 ease-out ${
            open ? "max-h-[520px] opacity-100" : "max-h-0 opacity-0"
          }`}
        >
          <Container size="xl" className="py-3 space-y-0.5">
            {mobileLinks.map((n, i) => (
              <Link
                key={`mob-${i}-${n.href}`}
                href={n.href}
                className={`flex items-center px-3 py-3 rounded-xl text-sm font-semibold transition-all duration-150 ${
                  isActive(n.href)
                    ? "text-primary-600 bg-primary-50"
                    : "text-ink-2 hover:bg-ink-9 hover:text-ink"
                }`}
              >
                {n.label}
              </Link>
            ))}
            <div className="pt-3 pb-1 flex gap-2 border-t border-ink-7/40 mt-2">
              {showLogin && (
                <Link href="/login" className="flex-1 h-11 inline-flex items-center justify-center rounded-xl border border-ink-7 text-ink-2 text-sm font-semibold hover:border-primary-300 hover:text-primary-600 transition-colors">
                  Log in
                </Link>
              )}
              <Link href={ctaLink} className="flex-1 h-11 inline-flex items-center justify-center rounded-xl text-white text-sm font-bold transition-all" style={{ background: "linear-gradient(135deg,#1A56DB,#1140A3)", boxShadow: "0 4px 12px rgba(26,86,219,0.3)" }}>
                {ctaText}
              </Link>
            </div>
          </Container>
        </div>
      </header>

      <style>{`
        @keyframes shimmer {
          0%   { transform: translateX(-100%); }
          100% { transform: translateX(200%); }
        }
      `}</style>
    </>
  );
}
